# ==============================================================================
# VET THE VAT - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development, or set these variables
# in your production environment (Vercel, Railway, Ubuntu systemd, Docker, etc.).
# ==============================================================================

NODE_ENV=production
VETTHEVAT_MARKETING_ONLY=0
NEXT_PUBLIC_VTV_LOCAL_WORKSPACE=1

# ------------------------------------------------------------------------------
# 1. WEB APPLICATION & AUTHENTICATION (PostgreSQL web_auth schema)
# ------------------------------------------------------------------------------
WEB_AUTH_ENABLED=1
WEB_AUTH_ENV=production
WEB_AUTH_ORIGIN=https://app.vetthevat.com
WEB_AUTH_DATABASE_NAME=vetthevat
WEB_AUTH_DATABASE_URL=postgresql://user:password@host:5432/vetthevat
WEB_AUTH_DATABASE_TLS=verify-full
WEB_AUTH_INSTALLATION_ID=
WEB_AUTH_CSRF_SECRET=
WEB_AUTH_OUTBOX_KEY=
WEB_AUTH_WORKER_SECRET=

# Production safety guards:
WEB_AUTH_PRODUCTION_CONNECTION_APPROVED=1
WEB_AUTH_PRODUCTION_DATABASE_APPROVED=vetthevat

# ------------------------------------------------------------------------------
# 2. SAAS MULTI-TENANT BACKEND (PostgreSQL saas & business schemas)
# ------------------------------------------------------------------------------
SAAS_BACKEND_ENABLED=1
SAAS_DATABASE_APPROVED=vetthevat
SAAS_DATABASE_URL=postgresql://user:password@host:5432/vetthevat
SAAS_INSTALLATION_ID=

# ------------------------------------------------------------------------------
# 3. FEATURE FLAGS
# ------------------------------------------------------------------------------
SAAS_ONBOARDING_ENABLED=1
SAAS_AUTO_TRIAL_ENABLED=1
SAAS_TEAM_ENABLED=1
SAAS_ORS_ENABLED=1
SAAS_INVOICE_SOFT_DELETE_ENABLED=1

# ------------------------------------------------------------------------------
# 4. DOCUMENT STORAGE (Choose Cloudflare R2 / AWS S3 OR Local Filesystem)
# ------------------------------------------------------------------------------
# Cloud S3 / Cloudflare R2 storage (Recommended for production):
SAAS_OBJECT_STORAGE_ENABLED=1
SAAS_OBJECT_STORAGE_APPROVED=1
SAAS_OBJECT_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
SAAS_OBJECT_BUCKET=vetthevat-invoices-prod
SAAS_OBJECT_REGION=auto
SAAS_OBJECT_ACCESS_KEY=
SAAS_OBJECT_SECRET_KEY=

# Local filesystem storage (Alternative for single-server standalone):
SAAS_LOCAL_ORIGINALS_ENABLED=0
SAAS_LOCAL_ORIGINALS_APPROVED=vetthevat

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (SMTP)
# ------------------------------------------------------------------------------
SMTP_ENABLED=1
WEB_AUTH_EMAIL_DELIVERY_APPROVED=1
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM_NAME="VET THE VAT"
SMTP_FROM_EMAIL=no-reply@vetthevat.com

# ------------------------------------------------------------------------------
# 6. STRIPE BILLING (Test Mode)
# ------------------------------------------------------------------------------
STRIPE_TEST_ENABLED=0
STRIPE_TEST_CONNECTION_APPROVED=0
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_ORS_ADDON_PRICE_ID=
STRIPE_API_VERSION=2024-06-20
SAAS_STRIPE_BILLING_ENABLED=0
STRIPE_WORKER_SECRET=

# ------------------------------------------------------------------------------
# 7. PLATFORM ADMINISTRATION & SUPER ADMIN CREDENTIALS
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_ENABLED=1
PLATFORM_ADMIN_SCHEMA_SHA256=0c1d019fad98ca9252d9ffa25909de0dbf6740f426c5a9afbb2311ca04a323bc
SUPER_ADMIN_EMAIL=admin@vetthevat.com
SUPER_ADMIN_PASSWORD=SuperAdmin@Vtv2026!


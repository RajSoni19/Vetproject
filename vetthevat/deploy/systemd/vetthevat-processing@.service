[Unit]
Description=VET THE VAT %i isolated decoder and OCR
After=vetthevat-clamav@%i.service
Requires=vetthevat-clamav@%i.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=vtv-processing-%i
Group=vtv-processing-%i
SupplementaryGroups=vtv-scan-%i
WorkingDirectory=/srv/vetthevat/%i/current/app
EnvironmentFile=/etc/vetthevat/%i/processing.env
ExecStart=/opt/vetthevat/node/bin/node workers/processing.cjs
RuntimeDirectory=vetthevat-%i
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryMax=2G
TasksMax=128
LimitNOFILE=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

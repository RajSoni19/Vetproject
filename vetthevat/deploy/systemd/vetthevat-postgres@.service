[Unit]
Description=VET THE VAT %i dedicated PostgreSQL 17 cluster (approval required)
After=local-fs.target
# initdb is deliberately not an ExecStartPre action. Existing data is never reset.
ConditionPathExists=/var/lib/vetthevat-%i-postgres/data/PG_VERSION

[Service]
Type=simple
User=vtv-postgres-%i
Group=vtv-postgres-%i
ExecStart=/usr/lib/postgresql/17/bin/postgres -D /var/lib/vetthevat-%i-postgres/data -c config_file=/etc/vetthevat/%i/postgresql.conf
KillSignal=SIGINT
TimeoutStopSec=120
Restart=on-failure
RestartSec=10
UMask=0077
RuntimeDirectory=vetthevat-postgres-%i
RuntimeDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vetthevat-%i-postgres
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=127.0.0.1
MemoryMax=1536M
TasksMax=128
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

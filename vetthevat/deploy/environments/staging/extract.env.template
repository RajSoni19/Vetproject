# TEMPLATE ONLY. Replace privately; never commit a rendered secret file.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
VTV_DEPLOYMENT_PROFILE=staging
# Neon London direct endpoint only; pooled -pooler endpoints are refused.
VTV_DATABASE_PROVIDER=neon
VTV_PUBLIC_ORIGIN=https://staging.vetthevat.com
VTV_DATABASE_HOST=<managed-staging-postgres-host>
VTV_DATABASE_PORT=5432
VTV_APPROVED_DATABASE_HOST=<same-managed-staging-postgres-host>
VTV_DATABASE_NAME=vtv_saas_staging
VTV_APPROVED_DATABASE_NAME=vtv_saas_staging
VTV_DATABASE_CA_FILE=/etc/vetthevat/staging/postgres-ca.pem
SAAS_INSTALLATION_ID=<new-managed-saas-installation-uuid>
WEB_AUTH_INSTALLATION_ID=<new-managed-auth-installation-uuid>
# Deliberately blank: fill only after schema, certificate, RLS and provider acceptance.
VTV_MANAGED_RUNTIME_APPROVED=
VETTHEVAT_MARKETING_ONLY=0
SAAS_LOCAL_ORIGINALS_ENABLED=0
SAAS_OBJECT_STORAGE_ENABLED=0
LEADS_ENABLED=0
CONTACT_ENABLED=0
VTV_WORKER_HEARTBEAT=/var/lib/vetthevat-staging-extract/heartbeat.json
DOCUMENT_WORKER_ENABLED=0
DOCUMENT_WORKER_DATABASE_URL=postgresql://vtv_saas_document_worker:<private-password>@<managed-staging-postgres-host>:5432/vtv_saas_staging
DOCUMENT_PROCESSING_SOCKET=/run/vetthevat-staging/processing.sock
R2_ENABLED=0
R2_ACCOUNT_ID=<approved-32-hex-account-id>
R2_APPROVED_ACCOUNT=<same-approved-account-id>
R2_BUCKET=vtv-web-staging-<unique-suffix>
R2_APPROVED_BUCKET=vtv-web-staging-<same-unique-suffix>
R2_ACCESS_KEY_ID=<bucket-scoped-object-read-write-key>
R2_SECRET_ACCESS_KEY=<private-r2-secret>
R2_AUDIT_API_TOKEN=<separate-bucket-policy-read-token>

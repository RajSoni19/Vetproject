# TEMPLATE ONLY. Separate root-owned 0600 EnvironmentFile; never source as shell.
VTV_BACKUP_APPROVED=
VTV_DATABASE_PROVIDER=serververse
SAAS_INSTALLATION_ID=<same-production-saas-installation-uuid>
VTV_SERVERVERSE_DATABASE_APPROVED=production:<same-production-saas-installation-uuid>:<approved-unused-loopback-port>
PGHOST=127.0.0.1
VTV_APPROVED_DATABASE_HOST=127.0.0.1
PGPORT=<approved-unused-loopback-port>
VTV_APPROVED_DATABASE_PORT=<same-approved-unused-loopback-port>
PGDATABASE=vtv_saas_production
PGUSER=vtv_backup_operator
PGPASSFILE=/etc/vetthevat/production/backup.pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/vetthevat/production/postgres-ca.pem
VTV_BACKUP_AGE_RECIPIENT=<public-age-recipient-private-identity-kept-off-host>
VTV_BACKUP_REMOTE=vtv-production-backup:<approved-private-backup-prefix>
# backup.pgpass / backup-rclone.conf: readable only by dedicated backup identity,
# mode 0400 and a traversable protected parent. Do not grant runtime access.

# Alternative to R2: approve only after private filesystem + recovery acceptance.
VTV_PRIVATE_ORIGINALS_ENABLED=0
VTV_PRIVATE_ORIGINALS_APPROVED=
VTV_PRIVATE_ORIGINALS_DIR=/var/lib/vetthevat-production-originals
VTV_ORIGINALS_OWNER_UID=<audited-vtv-web-production-uid>
VTV_ORIGINALS_GROUP_ID=<audited-vtv-originals-production-gid>

# Required instead when originals use external storage: SHA256 of reviewed recovery evidence.
VTV_EXTERNAL_ORIGINALS_BACKUP_ATTESTATION=

# TEMPLATE ONLY. Replace privately; never commit a rendered secret file.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
VTV_DEPLOYMENT_PROFILE=production
# Dedicated PostgreSQL 17 instance; use only the DBA-approved loopback port.
VTV_DATABASE_PROVIDER=serververse
VTV_PUBLIC_ORIGIN=https://vetthevat.com
VTV_DATABASE_HOST=127.0.0.1
VTV_DATABASE_PORT=<approved-unused-loopback-port>
VTV_APPROVED_DATABASE_HOST=127.0.0.1
VTV_DATABASE_NAME=vtv_saas_production
VTV_APPROVED_DATABASE_NAME=vtv_saas_production
VTV_DATABASE_CA_FILE=/etc/vetthevat/production/postgres-ca.pem
SAAS_INSTALLATION_ID=<new-managed-saas-installation-uuid>
WEB_AUTH_INSTALLATION_ID=<new-managed-auth-installation-uuid>
VTV_SERVERVERSE_DATABASE_APPROVED=production:<same-saas-installation-uuid>:<same-approved-unused-loopback-port>
# Deliberately blank: fill only after schema, certificate, RLS and provider acceptance.
VTV_MANAGED_RUNTIME_APPROVED=
VETTHEVAT_MARKETING_ONLY=0
SAAS_LOCAL_ORIGINALS_ENABLED=0
SAAS_OBJECT_STORAGE_ENABLED=0
LEADS_ENABLED=0
CONTACT_ENABLED=0
VTV_WORKER_HEARTBEAT=/var/lib/vetthevat-production-inspect/heartbeat.json
DOCUMENT_WORKER_ENABLED=0
DOCUMENT_WORKER_DATABASE_URL=postgresql://vtv_saas_document_worker:<percent-encoded-private-password>@127.0.0.1:<approved-unused-loopback-port>/vtv_saas_production
DOCUMENT_PROCESSING_SOCKET=/run/vetthevat-production/processing.sock
R2_ENABLED=0
R2_ACCOUNT_ID=<approved-32-hex-account-id>
R2_APPROVED_ACCOUNT=<same-approved-account-id>
R2_BUCKET=vtv-web-production-<unique-suffix>
R2_APPROVED_BUCKET=vtv-web-production-<same-unique-suffix>
R2_ACCESS_KEY_ID=<bucket-scoped-object-read-write-key>
R2_SECRET_ACCESS_KEY=<private-r2-secret>
R2_AUDIT_API_TOKEN=<separate-bucket-policy-read-token>

# Alternative to R2: approve only after private filesystem + recovery acceptance.
VTV_PRIVATE_ORIGINALS_ENABLED=0
VTV_PRIVATE_ORIGINALS_APPROVED=
VTV_PRIVATE_ORIGINALS_DIR=/var/lib/vetthevat-production-originals
VTV_ORIGINALS_OWNER_UID=<audited-vtv-web-production-uid>
VTV_ORIGINALS_GROUP_ID=<audited-vtv-originals-production-gid>

# Fresh production fence must be reviewed and match business.local_document_scope.
VTV_DOCUMENT_CREATED_AFTER=<approved-new-production-activation-ISO8601>

Foreground yes
DatabaseDirectory /var/lib/clamav
LocalSocket /run/vetthevat-clamav-@PROFILE@/clamd.sock
LocalSocketGroup vtv-scan-@PROFILE@
LocalSocketMode 660
FixStaleSocket yes
StreamMaxLength 10M
MaxFileSize 10M
MaxScanSize 100M
MaxRecursion 12
MaxFiles 1000
MaxThreads 2
MaxQueue 4
ReadTimeout 30
CommandReadTimeout 10
SendBufTimeout 1000
LogTime yes
LogClean no
LogVerbose no
SelfCheck 300
DetectPUA yes
AlertExceedsMax yes
AlertEncrypted yes

# A NEW named virtual host only. Review alongside existing sites before install.
# Requires Cloudflare origin certificate AND account/zone Authenticated Origin Pulls.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @HOSTNAME@;
    ssl_certificate /etc/vetthevat/@PROFILE@/tls/origin.crt;
    ssl_certificate_key /etc/vetthevat/@PROFILE@/tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_client_certificate /etc/vetthevat/@PROFILE@/tls/origin-pull-ca.pem;
    ssl_verify_client on;
    # No query strings, referers, bodies or auth headers in this site's logs.
    access_log /var/log/nginx/vetthevat-@PROFILE@.access.log vtv_redacted;
    error_log /var/log/nginx/vetthevat-@PROFILE@.error.log crit;
    client_max_body_size 10m;
    client_body_timeout 30s;
    send_timeout 60s;
    keepalive_timeout 30s;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Internal triggers are run by independent services, never at the edge.
    location ^~ /api/internal/ { return 404; }
    location = /api/health/ready { return 404; }
    location = /api/health/live {
        proxy_pass http://127.0.0.1:@PORT@;
        include /etc/nginx/vetthevat-@PROFILE@-proxy.conf;
    }
    location / {
        proxy_pass http://127.0.0.1:@PORT@;
        include /etc/nginx/vetthevat-@PROFILE@-proxy.conf;
    }
}

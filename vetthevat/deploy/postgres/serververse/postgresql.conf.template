# REVIEW TEMPLATE ONLY. Use in a dedicated VTV PostgreSQL 17 cluster after
# host inventory confirms the approved unused loopback port and resource budget.
listen_addresses = '127.0.0.1'
cluster_name = 'vetthevat-production'
port = <approved-unused-loopback-port>
ssl = on
ssl_min_protocol_version = 'TLSv1.2'
ssl_cert_file = '/etc/vetthevat/production/postgres-server.crt'
ssl_key_file = '/etc/vetthevat/production/postgres-server.key'
password_encryption = 'scram-sha-256'
# Conservative starting limits, subject to the measured shared-host capacity gate.
max_connections = 48
shared_buffers = '512MB'
effective_cache_size = '1GB'
work_mem = '4MB'
maintenance_work_mem = '64MB'
max_parallel_workers = 2
max_worker_processes = 4
autovacuum_max_workers = 2
idle_in_transaction_session_timeout = '60s'
log_statement = 'none'
log_min_error_statement = 'panic'
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_connections = on
log_disconnections = on
log_line_prefix = '%m [%p] user=%u db=%d app=%a client=%h '

unix_socket_directories = '/run/vetthevat-postgres-production'
hba_file = '/etc/vetthevat/production/pg_hba.conf'
ident_file = '/etc/vetthevat/production/pg_ident.conf'
